		#hide
	#loop
#loop
#show
#val
'</svg>
#equ
'<h4>7.5 Momento Mxy (tonf.m/m) — M12 en ETABS</h4>
$Map{Mxy_sp(x; y) @ x = 0 : a & y = 0 : b}
#val
'<svg width="'svg_w'" height="'svg_h'" style="position:relative;margin-top:-'svg_h + 20'px;" xmlns="http://www.w3.org/2000/svg">
#hide
#for jj = 0 : n_m
	#for ii = 0 : n_m
		cx_s = pad_l + ii*cw
		cy_s = pad_b + (n_m - jj)*ch
		val_s = Mxy_n.(ii + 1; jj + 1)
		#show
		#val
		'<circle cx="'cx_s'" cy="'cy_s'" r="6" fill="transparent" stroke="none"><title>Mxy('ii*d_x'; 'jj*d_y') = 'val_s' tonf.m/m</title></circle>
		#hide
	#loop
#loop
#show
