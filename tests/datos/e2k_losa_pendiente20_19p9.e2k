$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"

$ CONTROLS
  UNITS  "N"  "MM"  "C"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "S1"  HEIGHT 3000 MASTERSTORY "Yes"
  STORY "Base"  ELEV 0

$ MATERIAL PROPERTIES
  MATERIAL  "A36"    TYPE "Steel"    WEIGHTPERVOLUME 7.6972865E-05
  MATERIAL  "A36"    SYMTYPE "Isotropic"  E 199947.98  U 0.3  A 1.17E-05

$ FRAME SECTIONS
  FRAMESECTION  "Princ"  MATERIAL "A36"  SHAPE "Steel Pipe"  D 150 T 5
  FRAMESECTION  "Correa"  MATERIAL "A36"  SHAPE "Steel Pipe"  D 100 T 3

$ SLAB PROPERTIES
  SHELLPROP  "Cubierta"  PROPTYPE  "Slab"  MATERIAL "A36"  MODELINGTYPE "Membrane"  ONEWAYLOADDIST "Yes"  SLABTYPE "Slab"  SLABTHICKNESS 4

$ POINT COORDINATES
  POINT "P0_0"  0 0 0.0000
  POINT "P0_1"  0 500 0.0000
  POINT "P0_2"  0 1000 0.0000
  POINT "P0_3"  0 1500 0.0000
  POINT "P0_4"  0 2000 0.0000
  POINT "P1_0"  4000 0 1447.9798
  POINT "P1_1"  4000 500 1447.9798
  POINT "P1_2"  4000 1000 1447.9798
  POINT "P1_3"  4000 1500 1447.9798
  POINT "P1_4"  4000 2000 1447.9798

$ LINE CONNECTIVITIES
  LINE  "B0_0"  BEAM  "P0_0"  "P0_1"  0
  LINE  "B0_1"  BEAM  "P0_1"  "P0_2"  0
  LINE  "B0_2"  BEAM  "P0_2"  "P0_3"  0
  LINE  "B0_3"  BEAM  "P0_3"  "P0_4"  0
  LINE  "B1_0"  BEAM  "P1_0"  "P1_1"  0
  LINE  "B1_1"  BEAM  "P1_1"  "P1_2"  0
  LINE  "B1_2"  BEAM  "P1_2"  "P1_3"  0
  LINE  "B1_3"  BEAM  "P1_3"  "P1_4"  0
  LINE  "C0"  BEAM  "P0_0"  "P1_0"  0
  LINE  "C1"  BEAM  "P0_1"  "P1_1"  0
  LINE  "C2"  BEAM  "P0_2"  "P1_2"  0
  LINE  "C3"  BEAM  "P0_3"  "P1_3"  0
  LINE  "C4"  BEAM  "P0_4"  "P1_4"  0

$ AREA CONNECTIVITIES
  AREA "F0"  FLOOR  4  "P0_0"  "P1_0"  "P1_1"  "P0_1"  0  0  0  0
  AREA "F1"  FLOOR  4  "P0_1"  "P1_1"  "P1_2"  "P0_2"  0  0  0  0
  AREA "F2"  FLOOR  4  "P0_2"  "P1_2"  "P1_3"  "P0_3"  0  0  0  0
  AREA "F3"  FLOOR  4  "P0_3"  "P1_3"  "P1_4"  "P0_4"  0  0  0  0

$ POINT ASSIGNS
  POINTASSIGN  "P0_0"  "S1"  RESTRAINT "UX UY UZ RY"
  POINTASSIGN  "P0_4"  "S1"  RESTRAINT "UX UZ RY"
  POINTASSIGN  "P1_0"  "S1"  RESTRAINT "UY UZ RY"
  POINTASSIGN  "P1_4"  "S1"  RESTRAINT "UZ RY"

$ LINE ASSIGNS
  LINEASSIGN  "B0_0"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B0_1"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B0_2"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B0_3"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B1_0"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B1_1"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B1_2"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "B1_3"  "S1"  SECTION "Princ"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "C0"  "S1"  SECTION "Correa" RELEASE "TI M2I M3I TJ M2J M3J"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "C1"  "S1"  SECTION "Correa" RELEASE "TI M2I M3I TJ M2J M3J"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "C2"  "S1"  SECTION "Correa" RELEASE "TI M2I M3I TJ M2J M3J"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "C3"  "S1"  SECTION "Correa" RELEASE "TI M2I M3I TJ M2J M3J"  MINNUMSTA 3 AUTOMESH "NO"
  LINEASSIGN  "C4"  "S1"  SECTION "Correa" RELEASE "TI M2I M3I TJ M2J M3J"  MINNUMSTA 3 AUTOMESH "NO"

$ AREA ASSIGNS
  AREAASSIGN  "F0"  "S1"  SECTION "Cubierta"  OBJMESHTYPE "DEFAULT"  ADDRESTRAINT "No"  LINECONSTRAINT  "No"  ANG 90
  AREAASSIGN  "F1"  "S1"  SECTION "Cubierta"  OBJMESHTYPE "DEFAULT"  ADDRESTRAINT "No"  LINECONSTRAINT  "No"  ANG 90
  AREAASSIGN  "F2"  "S1"  SECTION "Cubierta"  OBJMESHTYPE "DEFAULT"  ADDRESTRAINT "No"  LINECONSTRAINT  "No"  ANG 90
  AREAASSIGN  "F3"  "S1"  SECTION "Cubierta"  OBJMESHTYPE "DEFAULT"  ADDRESTRAINT "No"  LINECONSTRAINT  "No"  ANG 90

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0

$ SHELL OBJECT LOADS
  AREALOAD  "F0"  "S1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 0.001
  AREALOAD  "F1"  "S1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 0.001
  AREALOAD  "F2"  "S1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 0.001
  AREALOAD  "F3"  "S1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 0.001

$ LOAD CASES
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "NONE"
  LOADCASE "Live"  LOADPAT  "Live"  SF  1

$ END OF MODEL FILE
