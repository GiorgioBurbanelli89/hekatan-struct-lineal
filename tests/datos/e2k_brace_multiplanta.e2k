  LOADCASE "VIENTO"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "VIENTO"  LOADPAT  "VIENTO"  SF  1 

$ LOAD COMBINATIONS
  COMBO "carga de servicio"  TYPE "Linear Add"  
  COMBO "carga de servicio"  LOADCASE "Dead"  SF 1 
  COMBO "carga de servicio"  LOADCASE "Live"  SF 1 
  COMBO "carga reactiva +25%L"  TYPE "Linear Add"  
  COMBO "carga reactiva +25%L"  LOADCASE "Dead"  SF 1 
  COMBO "carga reactiva +25%L"  LOADCASE "Live"  SF 0.25 
  COMBO "Comb1"  TYPE "Linear Add"  
  COMBO "Comb1"  DESIGN "Steel"  COMBOTYPE "Strength"  
  COMBO "Comb1"  DESIGN "Composite Column"  COMBOTYPE "Strength"  
