  LOADCASE "EspectroX"  MODALDAMPTYPE  "Constant"  CONSTDAMP  0.05 
  LOADCASE "EspectroX"  ECCENRATIOTYPICAL  0.05 
  LOADCASE "EspectroY"  TYPE  "Response Spectrum"  MODALCASE  "Modal"  
  LOADCASE "EspectroY"  ACCEL  "U2"  FUNC  "NEC 2015 E"  SF  9806.65 
