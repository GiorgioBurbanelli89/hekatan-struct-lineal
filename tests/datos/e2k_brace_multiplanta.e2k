  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  MAXMODES  9 MINMODES  3 EIGENSHIFTFREQ  0 EIGENCUTOFF  0 EIGENTOL  1E-09 
