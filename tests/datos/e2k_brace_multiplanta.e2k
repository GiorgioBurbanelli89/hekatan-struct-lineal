  LOADCASE "EspectroX"  ACCEL  "U1"  FUNC  "NEC 2015 E"  SF  9806.65 
  LOADCASE "EspectroX"  ACCEL  "U2"  FUNC  "NEC 2015 E"  SF  3268.9 
  LOADCASE "EspectroX"  ACCEL  "U3"  FUNC  "NEC 2015 E"  SF  6531.2 
