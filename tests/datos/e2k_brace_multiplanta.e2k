$ MASS SOURCE
  MASSSOURCE  "MASA SISMICA"    INCLUDEELEMENTS "No"    INCLUDEADDEDMASS "No"    INCLUDELOADS "Yes"    INCLUDEMOVE "No"    INCLUDELATERALMASS "Yes"    INCLUDEVERTICALMASS "Yes"    LUMPATSTORIES "Yes"    ISDEFAULT "Yes"  
  MASSSOURCELOAD  "MASA SISMICA"  "Dead"  1 
  MASSSOURCELOAD  "MASA SISMICA"  "Live"  0.1 

$ FUNCTIONS
  FUNCTION "RampTH"  FUNCTYPE "HISTORY"  HISTTYPE "USER"  
  FUNCTION "RampTH"  TIMEVAL "0  0  1  1  4  1"  
  FUNCTION "UnifTH"  FUNCTYPE "HISTORY"  HISTTYPE "USER"  
  FUNCTION "UnifTH"  TIMEVAL "0  1  1  1"  
  FUNCTION "UnifRS"  FUNCTYPE "SPECTRUM"  DAMPRATIO 0.05  SPECTYPE "USER"  
  FUNCTION "UnifRS"  TIMEVAL "0  1  1  1"  
  FUNCTION "NEC 2015 E"  FUNCTYPE "SPECTRUM"  DAMPRATIO 0.05  SPECTYPE "ECUADOR NORMA NEC-SE-DS 2015"    ZONE 0.5  ETA 1.8  FA 0.85  FD 1.5  SOILTYPE E  FS 2  I 1.3  R 4.86

