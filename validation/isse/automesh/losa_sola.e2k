  GRID "G1"  LABEL "2"  DIR "Y"  COORD 5  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Base"  ELEV 3000 

