  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "3"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "4"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  

$ LINE ASSIGNS

$ SLAB PROPERTIES
  SHELLPROP  "Losa"  PROPTYPE  "Slab"  MATERIAL "Conc_1"  MODELINGTYPE "ShellThick"  SLABTYPE "Slab"  SLABTHICKNESS 200 

