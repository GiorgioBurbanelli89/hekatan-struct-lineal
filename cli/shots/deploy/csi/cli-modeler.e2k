$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"  

$ CONTROLS
  UNITS  "N"  "MM"  "C"  
  TITLE1  "Hekatan Struct Lineal export"  
  TITLE2  "CLI Modeler (comandos) — Hekatan export"  
  PREFERENCE  MERGETOL 0.001
  RLLF  METHOD "ASCE7-10"  USEDEFAULTMIN "YES"  

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1.25 
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  
  GRID "G1"  LABEL "B"  DIR "X"  COORD 5  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Level_1"  HEIGHT 3000 MASTERSTORY "Yes"  
  STORY "Base"  ELEV 0 

$ DIAPHRAGM NAMES
  DIAPHRAGM "D1"    TYPE RIGID

$ MATERIAL PROPERTIES
  MATERIAL  "Conc_1"    TYPE "Concrete"    WEIGHTPERVOLUME 0.0000240263
  MATERIAL  "Conc_1"    SYMTYPE "Isotropic"  E 25000  U 0.2  A 0.00001
  MATERIAL  "Conc_1"    FC 24

$ FRAME SECTIONS
  FRAMESECTION  "C_G1"  MATERIAL "Conc_1"  SHAPE "General"  D 396.8627 B 403.1621 AREA 160000 AS2 133333.3333 AS3 133333.3333 I33 2100000000 I22 2100000000 TORSION 3584000000 S33POS 10583005.24 S33NEG 10583005.24 S22POS 10417645.79 S22NEG 10417645.79 Z33 10583005.24 Z22 10417645.79 R33 114.5643924 R22 114.5643924 
  FRAMESECTION  "C_G2"  MATERIAL "Conc_1"  SHAPE "General"  D 473.2864 B 316.9328 AREA 150000 AS2 125000 AS3 125000 I33 2800000000 I22 2800000000 TORSION 3150000000 S33POS 11832159.57 S33NEG 11832159.57 S22POS 17669358.29 S22NEG 17669358.29 Z33 11832159.57 Z22 17669358.29 R33 136.6260102 R22 136.6260102 

$ POINT COORDINATES
  POINT "1"  0 0 
  POINT "2"  5000 0 

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "E2"  BEAM  "1"  "2"  0

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Level_1"  SECTION "C_G1"  MINNUMSTA 1 AUTOMESH "YES"  MESHATINTERSECTIONS "YES"  
  LINEASSIGN  "C2"  "Level_1"  SECTION "C_G1"  MINNUMSTA 1 AUTOMESH "YES"  MESHATINTERSECTIONS "YES"  
  LINEASSIGN  "E2"  "Level_1"  SECTION "C_G2"  MINNUMSTA 3 AUTOMESH "YES"  MESHATINTERSECTIONS "YES"  

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0

$ POINT OBJECT LOADS
  POINTLOAD  "1"  "Level_1"  TYPE "FORCE"  LC "Dead"  FX 10000  FY 0  FZ -50000  MX 0  MY 0  MZ 0
  POINTLOAD  "2"  "Level_1"  TYPE "FORCE"  LC "Dead"  FX 10000  FY 0  FZ -50000  MX 0  MY 0  MZ 0

$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"  
  PDELTA  METHOD "NONE"  

$ MASS SOURCE
  MASSSOURCE  "MsSrc1"    INCLUDEELEMENTS "No"    INCLUDEADDEDMASS "No"    INCLUDELOADS "Yes"    INCLUDEMOVE "No"    INCLUDELATERALMASS "Yes"    INCLUDEVERTICALMASS "No"    LUMPATSTORIES "Yes"    ISDEFAULT "Yes"  
  MASSSOURCELOAD  "MsSrc1"  "Dead"  1 

$ LOAD CASES
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Dead"  LOADPAT  "Dead"  SF 1 
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Live"  LOADPAT  "Live"  SF 1 
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  MAXMODES 12  MINMODES 1  EIGENSHIFTFREQ 0  EIGENCUTOFFFREQ 0  EIGENTOL 1E-09  ALLOWAUTOFREQSHIFT "Yes"  

$ LOAD COMBINATIONS
  COMBO "Servicio D+L"  TYPE "Linear Add"  
  COMBO "Servicio D+L"  LOADCASE  "Dead"  SF 1 
  COMBO "Servicio D+L"  LOADCASE  "Live"  SF 1 
  COMBO "1.4D"  TYPE "Linear Add"  
  COMBO "1.4D"  LOADCASE  "Dead"  SF 1.4 
  COMBO "1.2D+1.6L"  TYPE "Linear Add"  
  COMBO "1.2D+1.6L"  LOADCASE  "Dead"  SF 1.2 
  COMBO "1.2D+1.6L"  LOADCASE  "Live"  SF 1.6 
  COMBO "1.4D+1.7L"  TYPE "Linear Add"  
  COMBO "1.4D+1.7L"  LOADCASE  "Dead"  SF 1.4 
  COMBO "1.4D+1.7L"  LOADCASE  "Live"  SF 1.7 

  END
