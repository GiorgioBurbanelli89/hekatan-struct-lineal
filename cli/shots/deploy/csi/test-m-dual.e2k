  LOADCASE "Modal"  MAXMODES  24 MINMODES  1 EIGENSHIFTFREQ  0 EIGENCUTOFF  0 EIGENTOL  1E-09 
  LOADCASE "Sismo NEC"  TYPE  "Response Spectrum"  MODALCASE  "Modal"  
  LOADCASE "Sismo NEC"  ACCEL  "U1"  FUNC  "NEC"  SF  1.22583125  
