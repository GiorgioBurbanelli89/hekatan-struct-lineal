$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0

$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"  
  PDELTA  METHOD "NONE"  

$ MASS SOURCE
  MASSSOURCE  "MsSrc1"    INCLUDEELEMENTS "No"    INCLUDEADDEDMASS "No"    INCLUDELOADS "Yes"    INCLUDEMOVE "No"    INCLUDELATERALMASS "Yes"    INCLUDEVERTICALMASS "No"    LUMPATSTORIES "Yes"    ISDEFAULT "Yes"  
  MASSSOURCELOAD  "MsSrc1"  "Dead"  1 

$ LOAD CASES
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Dead"  LOADPAT  "Dead"  SF 1 
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Live"  LOADPAT  "Live"  SF 1 
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  MAXMODES 12  MINMODES 1  EIGENSHIFTFREQ 0  EIGENCUTOFFFREQ 0  EIGENTOL 1E-09  ALLOWAUTOFREQSHIFT "Yes"  

$ LOAD COMBINATIONS
  COMBO "Servicio D+L"  TYPE "Linear Add"  
  COMBO "Servicio D+L"  LOADCASE  "Dead"  SF 1 
  COMBO "Servicio D+L"  LOADCASE  "Live"  SF 1 
  COMBO "1.4D"  TYPE "Linear Add"  
  COMBO "1.4D"  LOADCASE  "Dead"  SF 1.4 
  COMBO "1.2D+1.6L"  TYPE "Linear Add"  
  COMBO "1.2D+1.6L"  LOADCASE  "Dead"  SF 1.2 
  COMBO "1.2D+1.6L"  LOADCASE  "Live"  SF 1.6 
  COMBO "1.4D+1.7L"  TYPE "Linear Add"  
  COMBO "1.4D+1.7L"  LOADCASE  "Dead"  SF 1.4 
  COMBO "1.4D+1.7L"  LOADCASE  "Live"  SF 1.7 

  END
$ END OF MODEL FILE